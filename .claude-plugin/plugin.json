{
  "name": "docflow",
  "description": "Lightweight documentation memory for AI coding agents. Scaffolds a 7-category docs tree, teaches naming + cross-linking + changelog discipline via skills, and auto-loads the docs index + newest real changelog entry on session start.",
  "version": "0.2.0",
  "author": {
    "name": "Mohamed Adem Bel Hadj Amor",
    "url": "https://github.com/MedAdemBHA"
  },
  "homepage": "https://github.com/MedAdemBHA/docflow",
  "license": "MIT",
  "keywords": ["documentation", "changelog", "adr", "knowledge-base", "context", "onboarding"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/docflow-context.sh",
            "timeout": 5,
            "statusMessage": "Loading docflow context..."
          }
        ]
      }
    ]
  }
}
